# Copy to .env (git-ignored). All values are optional; defaults shown.
# Paths may be absolute or relative to the repository root.
VERIFRAME_DATA_DIR=data
VERIFRAME_STORAGE_DIR=data/storage
VERIFRAME_DB_PATH=data/veriframe.db
VERIFRAME_KEYS_DIR=keys
VERIFRAME_MODEL_DIR=model_weights
VERIFRAME_SAMPLES_DIR=data/samples
VERIFRAME_MAX_IMAGE_MB=15
VERIFRAME_MAX_VIDEO_MB=60
VERIFRAME_MAX_VIDEO_SECONDS=120
VERIFRAME_VIDEO_SAMPLE_FRAMES=16
VERIFRAME_MAX_IMAGE_PIXELS=40000000
# Browser origins allowed by CORS (the Vite dev server). The dev proxy means most requests are same-origin anyway.
VERIFRAME_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional PEM bundle of additional C2PA trust anchors (e.g. the official C2PA trust list) to append to the local demo root.
# VERIFRAME_EXTRA_TRUST_ANCHORS=keys/extra_anchors.pem
# Limit PyTorch CPU threads (0 = library default)
VERIFRAME_TORCH_THREADS=0
